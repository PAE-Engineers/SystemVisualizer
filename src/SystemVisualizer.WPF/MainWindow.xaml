<Window
    Height="450"
    Loaded="MainWindow_OnLoaded"
    Title="MainWindow"
    Width="800"
    mc:Ignorable="d"
    x:Class="SystemVisualizer.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interfaces="clr-namespace:SystemVisualizer.Core.Interfaces;assembly=SystemVisualizer.Core"
    xmlns:local="clr-namespace:SystemVisualizer.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SystemVisualizer.Core.Models;assembly=SystemVisualizer.Core"
    xmlns:nodify="https://miroiu.github.io/nodify"
    xmlns:nodify1="clr-namespace:Nodify;assembly=Nodify"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <GeometryDrawing
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
            x:Key="SmallGridGeometry" />

        <GeometryDrawing
            Brush="{StaticResource NodifyEditor.SelectionRectangleBackgroundBrush}"
            Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z"
            x:Key="LargeGridGeometry" />

        <DrawingBrush
            Drawing="{StaticResource SmallGridGeometry}"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=Editor}"
            Viewport="0 0 20 20"
            ViewportUnits="Absolute"
            x:Key="SmallGridLinesDrawingBrush" />

        <DrawingBrush
            Drawing="{StaticResource LargeGridGeometry}"
            Opacity="0.5"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=Editor}"
            Viewport="0 0 100 100"
            ViewportUnits="Absolute"
            x:Key="LargeGridLinesDrawingBrush" />
    </Window.Resources>

    <Grid Background="{StaticResource NodifyEditor.BackgroundBrush}">
        <nodify1:NodifyEditor
            Background="{StaticResource SmallGridLinesDrawingBrush}"
            Connections="{Binding Connections}"
            ItemsSource="{Binding Nodes}"
            x:Name="Editor">

            <nodify:NodifyEditor.ConnectionTemplate>

                <DataTemplate DataType="{x:Type models:Edge}">
                    <nodify:LineConnection Source="{Binding Source.Anchor, Converter={StaticResource PointConverter}}" Target="{Binding Target.Anchor, Converter={StaticResource PointConverter}}" />
                </DataTemplate>

            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.ItemTemplate>

                <DataTemplate DataType="{x:Type models:Node}">
                    <nodify:Node
                        Header="{Binding Name}"
                        Input="{Binding Inputs}"
                        Output="{Binding Outputs}">
                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate DataType="{x:Type models:Connector}">
                                <nodify:NodeInput
                                    Anchor="{Binding Anchor, Mode=OneWayToSource, Converter={StaticResource PointConverter}}"
                                    Header="{Binding Name}"
                                    IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>

                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate DataType="{x:Type models:Connector}">
                                <nodify:NodeOutput
                                    Anchor="{Binding Anchor, Mode=OneWayToSource, Converter={StaticResource PointConverter}}"
                                    Header="{Binding Name}"
                                    IsConnected="{Binding IsConnected}" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>

                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}">
                    <Setter Property="Location" Value="{Binding Location, Converter={StaticResource PointConverter}}" />
                    <Setter Property="ActualSize" Value="{Binding Size, Converter={StaticResource SizeConverter}, Mode=OneWayToSource}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

        </nodify1:NodifyEditor>

        <Grid Background="{StaticResource LargeGridLinesDrawingBrush}" Panel.ZIndex="-2" />
    </Grid>

</Window>
